{
  "name": "otools-puter-spreadsheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spreadsheet (HeyPuter/everything) as an OTools plugin: the same editor, with documents stored as plain files on this computer instead of in a Puter cloud account.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "check-upstream": "node scripts/sync-upstream.mjs --check",
    "tree": "node scripts/build.mjs --tree",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/test.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "verify": "node scripts/verify-plugin.mjs",
    "i18n-report": "node scripts/i18n-report.mjs",
    "release": "node scripts/build.mjs && node scripts/pack-plugin.mjs && node scripts/verify-plugin.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@xmldom/xmldom": "0.9.12",
    "lucide": "^1.28.0"
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
